# Database Connection URL (PostgreSQL for production / SQLite for zero-config local dev)
# Example for PostgreSQL: postgresql+psycopg://postgres:password@localhost:5432/billflow
# Example for SQLite: sqlite:///./billflow.db
DATABASE_URL=sqlite:///./billflow.db

# JWT Secret Key for authenticating sessions (generate a secure random 64-character string)
SECRET_KEY=generate_a_secure_random_secret_key_here_e.g._openssl_rand_hex_32

# Frontend URL for CORS configuration (Vercel deployment URL or localhost)
FRONTEND_URL=http://localhost:3000

